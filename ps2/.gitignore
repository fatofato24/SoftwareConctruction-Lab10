# Ignore all files by default
*

# Allow source and test files
!src/
!src/**/
!src/**/*.java
!test/
!test/**/
!test/**/*.java

# Allow README and gitignore itself
!README.md
!.gitignore

# Ignore compiled Java classes
*.class

# Ignore Eclipse/IntelliJ project files
/.classpath
/.project
/.settings/
/.idea/
/out/
/*.iml

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore build folders (if using Gradle/Maven)
build/
target/
.gradle/
